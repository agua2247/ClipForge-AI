{
  "manifest_version": 3,
  "name": "ClipForge AI — aguagamer2247",
  "version": "0.1.0",
  "description": "Create and organize branded YouTube Shorts with ClipForge AI.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://clipforge-ai-api.onrender.com/*"
  ],
  "action": {
    "default_title": "Open ClipForge AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
